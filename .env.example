# Enrichment mode
ZOOMINFO_ENABLED=false
ZOOMINFO_CLIENT_ID=
ZOOMINFO_PRIVATE_KEY=

# Dashboard/API access
DASHBOARD_API_KEY=change-this-to-a-long-random-value
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Output
OUTPUT_FORMAT=xlsx
OUTPUT_DIR=./output

# Scraping
MAX_LEADS=1000
CHROME_PATH=

# Email verification
SMTP_TIMEOUT=10

# Database
DB_PATH=./pipeline.db

# OpenAI extraction and draft generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Unsubscribe links
UNSUBSCRIBE_SECRET=
PUBLIC_BASE_URL=http://localhost:8000

# Microsoft Graph - Email Sending
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SENDER_EMAIL=
GLOBAL_CONTACT_COOLDOWN_DAYS=30
BULK_SEND_RATE_PER_MINUTE=20
SKIP_WEEKENDS=false

# Background jobs
SCHEDULER_ENABLED=true
REPLY_MONITOR_ENABLED=false
REPLY_MONITOR_INTERVAL_SECONDS=300

# Runtime environment
# Use APP_ENV=production for deployed environments.
APP_ENV=development

# SQLite production safety
SQLITE_TIMEOUT_SECONDS=30
DB_BACKUP_DIR=./backups

# Email verification policy
# false = allow risky emails like role-based/DNS-error addresses; true = block them before send.
EMAIL_VERIFICATION_BLOCK_RISKY=false

# Graph retry policy
GRAPH_RETRY_DELAY_MINUTES=15



