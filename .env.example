# Enrichment mode
ZOOMINFO_ENABLED=false
ZOOMINFO_CLIENT_ID=
ZOOMINFO_PRIVATE_KEY=

# Dashboard/API access
DASHBOARD_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Output
OUTPUT_FORMAT=xlsx
OUTPUT_DIR=./output

# Scraping
MAX_LEADS=1000

# Email verification
SMTP_TIMEOUT=10

# Database
DB_PATH=./pipeline.db

# OpenAI — Phase 2, not active yet
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Unsubscribe links
UNSUBSCRIBE_SECRET=
PUBLIC_BASE_URL=http://localhost:8000

# Microsoft Graph - Email Sending
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SENDER_EMAIL=
GLOBAL_CONTACT_COOLDOWN_DAYS=30
