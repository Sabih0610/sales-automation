# Runtime mode
# Development uses project-relative paths by default.
# Desktop production sets RCLP_DESKTOP_MODE=built and APP_DATA_DIR from Electron.
APP_ENV=development
RCLP_DESKTOP_MODE=

# Dashboard/API access
# Use a long random value. Electron can generate a runtime key when missing,
# but production/server deployments should set this explicitly.
DASHBOARD_API_KEY=change-this-to-a-long-random-value
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Runtime data paths
# Leave APP_DATA_DIR empty in development to keep project-folder behavior.
# Desktop production default:
#   %LOCALAPPDATA%\RoyalCyberLeadPipeline
APP_DATA_DIR=
DB_PATH=./pipeline.db
OUTPUT_DIR=./output
LOG_DIR=./logs
CHROME_PROFILE_DIR=
DEBUG_DIR=./debug
KNOWLEDGE_BASE_DIR=./knowledge_base
DB_BACKUP_DIR=./backups

# Output
OUTPUT_FORMAT=xlsx

# Scraping / Chrome
MAX_LEADS=1000
CHROME_PATH=
SCRAPER_BATCH_PAGE_LIMIT=0
BULK_SCRAPE_BATCH_COOLDOWN_SECONDS=300
SALES_NAV_SCROLL_DELAY_MIN=4
SALES_NAV_SCROLL_DELAY_MAX=8
SALES_NAV_PAGE_DELAY_MIN=8
SALES_NAV_PAGE_DELAY_MAX=16
SALES_NAV_CHUNK_LEAD_LIMIT=500
SALES_NAV_CHUNK_PAGE_LIMIT=25
SALES_NAV_COOLDOWN_MINUTES=20
SALES_NAV_REPAIR_WITH_OPENAI=false

# ZoomInfo enrichment
ZOOMINFO_ENABLED=false
ZOOMINFO_CLIENT_ID=
ZOOMINFO_PRIVATE_KEY=

# OpenAI extraction and draft generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_PERSONALISED_DRAFTS_ENABLED=true

# Email verification
SMTP_TIMEOUT=10
# false = allow risky emails like role-based/DNS-error addresses; true = block them before send.
EMAIL_VERIFICATION_BLOCK_RISKY=false

# Unsubscribe links
UNSUBSCRIBE_SECRET=
PUBLIC_BASE_URL=http://localhost:8000
UNSUBSCRIBE_FOOTER_ENABLED=false

# Microsoft Graph - email sending
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SENDER_EMAIL=
SENDER_NAME=Royal Cyber Team
GLOBAL_CONTACT_COOLDOWN_DAYS=30
GRAPH_RETRY_DELAY_MINUTES=15

# Sending policy
BULK_SEND_RATE_PER_MINUTE=20
SEND_WINDOW_ENABLED=false
SEND_WINDOW_START=09:00
SEND_WINDOW_END=17:30
SKIP_WEEKENDS=false
SEND_RAMP_ENABLED=false
SEND_RAMP_OVERRIDE=
DAILY_CAP_ENABLED=true
PER_DOMAIN_CAP_ENABLED=false
CAMPAIGN_DAILY_LIMIT_ENABLED=false
MAX_EMAILS_PER_DAY=150
SEND_DELAY_SECONDS=3

# Background jobs
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
REPLY_MONITOR_ENABLED=false
REPLY_MONITOR_INTERVAL_SECONDS=300
ACS_REPLY_TO_EMAIL=

# SQLite production safety
SQLITE_TIMEOUT_SECONDS=30
